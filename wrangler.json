{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flyr",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "flyr.ca5.me",
      "custom_domain": true
    }
  ]
}
